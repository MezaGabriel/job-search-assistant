# Copy to .env and fill. Never commit .env.

# ── LLM (Claude Code CLI, no API key needed) ──────────────────────────────────
# Uses your Claude Pro/Max subscription. Run `claude` once and /login.
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
# CLAUDE_MODEL=            # empty = plan default (used for CV/cover tailoring)
CLAUDE_MODEL_CHEAP=haiku   # scoring + mail triage — cheap, high-volume calls

LLM_PROVIDER=claude
# Fallback: when claude -p fails, use opencode (free models). npm i -g opencode-ai
# OPENCODE_FALLBACK=true
# OPENCODE_FALLBACK_MODEL=opencode/deepseek-v4-flash-free

# ── Apify (job search) ────────────────────────────────────────────────────────
# Get your token at: https://console.apify.com/account/integrations
APIFY_TOKEN=

# Comma-separated list of Apify actors to run IN PARALLEL per search.
# Results from all actors are merged + deduped automatically.
# Each actor must be enabled/subscribed in your Apify account.
#
# Popular job-search actors (check console.apify.com/store):
#   apify/indeed-scraper                  — Indeed (free tier ✓)
#   bebity/google-jobs-scraper            — Google for Jobs (very broad)
#   apify/glassdoor-scraper               — Glassdoor
#   curious_coder/remoteok-jobs-scraper   — RemoteOK (remote-only)
#   bebity/linkedin-jobs-scraper          — LinkedIn jobs
#   epctex/monster-scraper                — Monster
#   curious_coder/dice-scraper            — Dice (tech roles)
#   tri_angle/ziprecruiter-scraper        — ZipRecruiter
#
# Single actor:
APIFY_ACTORS=misceres/indeed-scraper
# Multiple actors (run in parallel, results merged):
# APIFY_ACTORS=misceres/indeed-scraper,bebity/google-jobs-scraper,apify/glassdoor-scraper

# 2-letter country for the scrapers (us, gb, ca, au …)
APIFY_COUNTRY=us

# Freshness window in days: only jobs posted in the last N days (1 = 24 hours).
# Fresh postings = less competition. If the fresh search returns 0, the search
# automatically widens to SEARCH_MAX_DAYS. Newest jobs always rank first.
SEARCH_FRESH_DAYS=1
SEARCH_MAX_DAYS=7

# ── Chrome — open jobs for manual apply ──────────────────────────────────────
# Profile name to open URLs in your existing Chrome (no debug mode needed).
# Find profiles in: %LOCALAPPDATA%\Google\Chrome\User Data\
# e.g. "Default", "Profile 1", "Profile 2". Leave empty = whichever is active.
CHROME_PROFILE=Default

# ── Google OAuth (Gmail + Calendar) ──────────────────────────────────────────
# 1. console.cloud.google.com → new project → enable Gmail API + Calendar API
# 2. OAuth consent screen → External → add your email under Test users
# 3. Credentials → OAuth client ID → Desktop app → download JSON → data/oauth-client.json
# 4. npm run auth  → opens browser, saves tokens
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:53682/oauth2callback

# ── Tuning ────────────────────────────────────────────────────────────────────
# Max tailored applications per run/day (overrides dailyApplyCap in profile.json)
DAILY_APPLY_CAP=3

# Minimum fit score (1-10) to tailor + queue. 6 = solid fit only.
MIN_SCORE=6

# Candidates evaluated per prepared slot. evalLimit = DAILY_APPLY_CAP × this.
EVAL_MULTIPLIER=5

# Max chars of job description sent to LLM. Long HTML = #1 token sink. Default 1200.
DESC_CLIP=1200

# Log every LLM call's full prompt+response to data/llm.log (for debugging)
LLM_LOG=false

# ── Daemon schedule ───────────────────────────────────────────────────────────
# CYCLE_CRON=0 8,18 * * *   # 2× per day (saves tokens vs hourly)
# RUN_ON_BOOT=false
